{
	"appId": "com.adaptalyfe.app",
	"appName": "Adaptalyfe",
	"webDir": "dist/public",
	"server": {
		"url": "https://app.getadaptalyfeapp.com",
		"androidScheme": "https",
		"iosScheme": "https",
		"cleartext": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"launchShowDuration": 0,
			"backgroundColor": "#ecfdf5",
			"showSpinner": true,
			"spinnerColor": "#10b981",
			"androidSpinnerStyle": "large",
			"iosSpinnerStyle": "large"
		},
		"StatusBar": {
			"style": "dark",
			"backgroundColor": "#ffffff"
		},
		"Keyboard": {
			"resize": "native"
		}
	},
	"android": {
		"webContentsDebuggingEnabled": false
	},
	"ios": {
		"contentInset": "automatic"
	},
	"packageClassList": [
		"AppPlugin",
		"FilesystemPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
